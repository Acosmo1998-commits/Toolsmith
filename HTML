<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>OS Toolsmith Terminal</title>
  
  <!-- xterm.js CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.css" />
  
  <style>
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: #121212;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow: hidden;
    }

    #app-container {
      display: flex;
      flex-direction: column;
      height: 100vh;
      width: 100vw;
    }

    #status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      background-color: #1e1e1e;
      border-bottom: 1px solid #333;
      font-size: 14px;
      height: 40px;
      box-sizing: border-box;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #f39c12;
      transition: background-color 0.3s ease;
    }

    .nav-tabs {
      display: flex;
      gap: 6px;
    }

    .nav-tabs button {
      background: #2a2a2a;
      border: 1px solid #444;
      color: #aaa;
      padding: 4px 10px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
    }

    .nav-tabs button.active-tab {
      background: #007acc;
      color: #fff;
      border-color: #007acc;
    }

    .view-panel {
      flex: 1;
      width: 100%;
      height: calc(100vh - 40px);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    #terminal-container {
      padding: 4px;
      box-sizing: border-box;
    }

    #file-container {
      background: #181818;
      padding: 10px;
      box-sizing: border-box;
      overflow-y: auto;
    }

    #file-breadcrumb {
      padding: 6px 10px;
      background: #222;
      border-radius: 4px;
      font-family: monospace;
      margin-bottom: 8px;
      color: #00bcd4;
    }

    .file-item {
      padding: 12px 8px;
      border-bottom: 1px solid #2c2c2c;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
    }

    .file-item:active { background: #2a2a2a; }

    #editor-pane {
      position: absolute;
      top: 40px; left: 0; right: 0; bottom: 0;
      background: #121212;
      display: flex;
      flex-direction: column;
      z-index: 10;
    }

    .editor-toolbar {
      display: flex;
      justify-content: space-between;
      padding: 8px 12px;
      background: #222;
      align-items: center;
    }

    .editor-toolbar button {
      background: #007acc;
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
    }

    #file-textarea {
      flex: 1;
      background: #1e1e1e;
      color: #f8f8f2;
      border: none;
      padding: 10px;
      font-family: monospace;
      font-size: 13px;
      resize: none;
    }
  </style>
</head>
<body>

  <div id="app-container">
    <!-- Header Navigation Bar -->
    <div id="status-bar">
      <div class="status-indicator">
        <div id="status-dot"></div>
        <span id="status-text">Connecting...</span>
      </div>
      <div class="nav-tabs">
        <button onclick="switchTab('terminal')" id="btn-terminal" class="active-tab">Terminal</button>
        <button onclick="switchTab('files')" id="btn-files">Files</button>
        <button onclick="switchTab('admin')" id="btn-admin" style="display: none;">Admin</button>
      </div>
    </div>

    <!-- Terminal Viewport -->
    <div id="terminal-container" class="view-panel"></div>

    <!-- File Browser & Editor Viewport -->
    <div id="file-container" class="view-panel" style="display: none;">
      <div id="file-breadcrumb">/workspace</div>
      <div id="file-list"></div>
      <div id="editor-pane" style="display: none;">
        <div class="editor-toolbar">
          <span id="editing-filename" style="font-family: monospace; font-size: 13px;"></span>
          <div>
            <button onclick="saveFile()" style="background: #2ecc71; margin-right: 6px;">Save</button>
            <button onclick="closeEditor()" style="background: #e74c3c;">Close</button>
          </div>
        </div>
        <textarea id="file-textarea"></textarea>
      </div>
    </div>

    <!-- Admin Dashboard Viewport -->
    <div id="admin-container" class="view-panel" style="display: none; padding: 16px; box-sizing: border-box; background: #151515; overflow-y: auto;">
      <h3>🛠️ System Admin Control Panel</h3>
      <p style="color: #888; font-size: 13px;">Restricted background metrics & container oversight.</p>
      
      <div id="admin-metrics-card" style="background: #222; border: 1px solid #333; border-radius: 6px; padding: 14px; margin-top: 15px;">
        Loading system metrics...
      </div>

      <button onclick="triggerMaintenance()" style="margin-top: 20px; background: #c0392b; color: white; border: none; padding: 10px 16px; border-radius: 4px; cursor: pointer;">
        Trigger Container Maintenance Check
      </button>
    </div>
  </div>

  <!-- xterm.js and Fit Addon CDNs -->
  <script src="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.js"></script>

  <script>
    // Configuration & State
    let currentPath = '';
    let activeEditingFile = '';
    let userRole = 'admin'; // Change based on authentication logic
    const jwtToken = "your_test_or_user_jwt_token_here";
    const adminJwtToken = "your_admin_jwt_token_here";

    function initAuthUI() {
      if (userRole === 'admin') {
        document.getElementById('btn-admin').style.display = 'inline-block';
      }
    }
    initAuthUI();

    // Initialize xterm.js
    const term = new Terminal({
      cursorBlink: true,
      macOptionIsMeta: true,
      fontSize: 14,
      theme: { background: '#121212', foreground: '#f8f8f2', cursor: '#50fa7b' }
    });

    const fitAddon = new FitAddon.FitAddon();
    term.loadAddon(fitAddon);
    term.open(document.getElementById('terminal-container'));
    fitAddon.fit();

    // WebSocket Connection Setup
    const protocol = window.location.protocol === 'https:' ? 'wss://' : 'ws://';
    const host = window.location.host || 'localhost:3000';
    const wsUrl = `${protocol}${host}?token=${encodeURIComponent(jwtToken)}`;

    const ws = new WebSocket(wsUrl);
    ws.binaryType = 'arraybuffer';

    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');

    ws.onopen = () => {
      statusDot.style.backgroundColor = '#2ecc71';
      statusText.textContent = 'Connected';
      fitAddon.fit();
      sendResize();
    };

    ws.onclose = () => {
      statusDot.style.backgroundColor = '#e74c3c';
      statusText.textContent = 'Disconnected';
      term.writeln('\r\n\x1b[31m[Connection lost. Reconnecting...]\x1b[0m');
    };

    ws.onmessage = (event) => {
      if (event.data instanceof ArrayBuffer) {
        term.write(new Uint8Array(event.data));
      } else {
        term.write(event.data);
      }
    };

    term.onData((data) => {
      if (ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'input', data: data }));
      }
    });

    function sendResize() {
      if (ws.readyState === WebSocket.OPEN) {
        fitAddon.fit();
        ws.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows }));
      }
    }

    window.addEventListener('resize', () => sendResize());
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', () => setTimeout(sendResize, 100));
    }

    // Navigation & Tab Switching
    function switchTab(tab) {
      document.getElementById('terminal-container').style.display = tab === 'terminal' ? 'flex' : 'none';
      document.getElementById('file-container').style.display = tab === 'files' ? 'flex' : 'none';
      document.getElementById('admin-container').style.display = tab === 'admin' ? 'block' : 'none';
      
      document.getElementById('btn-terminal').className = tab === 'terminal' ? 'active-tab' : '';
      document.getElementById('btn-files').className = tab === 'files' ? 'active-tab' : '';
      document.getElementById('btn-admin').className = tab === 'admin' ? 'active-tab' : '';
      
      if (tab === 'files') {
        loadFiles(currentPath);
      } else if (tab === 'admin') {
        loadAdminMetrics();
      } else {
        setTimeout(() => fitAddon.fit(), 50);
      }
    }

    // File Browser Logic
    async function loadFiles(path) {
      try {
        const res = await fetch(`/api/files?path=${encodeURIComponent(path)}`, {
          headers: { 'Authorization': `Bearer ${jwtToken}` }
        });
        const items = await res.json();
        currentPath = path;
        
        document.getElementById('file-breadcrumb').textContent = `/workspace/${path}`;
        const listEl = document.getElementById('file-list');
        listEl.innerHTML = '';

        if (path !== '') {
          const parentPath = path.split('/').slice(0, -1).join('/');
          listEl.innerHTML += `<div class="file-item" onclick="loadFiles('${parentPath}')">📁 <strong>.. (Up)</strong></div>`;
        }

        items.forEach(item => {
          const icon = item.isDirectory ? '📁' : '📄';
          const action = item.isDirectory ? `loadFiles('${item.path}')` : `openFile('${item.path}')`;
          listEl.innerHTML += `<div class="file-item" onclick="${action}"><span>${icon} ${item.name}</span></div>`;
        });
      } catch (err) {
        console.error('Failed to load files', err);
      }
    }

    async function openFile(filePath) {
      try {
        const res = await fetch(`/api/file?path=${encodeURIComponent(filePath)}`, {
          headers: { 'Authorization': `Bearer ${jwtToken}` }
        });
        const data = await res.json();
        activeEditingFile = filePath;
        
        document.getElementById('editing-filename').textContent = filePath;
        document.getElementById('file-textarea').value = data.content;
        document.getElementById('editor-pane').style.display = 'flex';
      } catch (err) {
        alert('Could not open file');
      }
    }

    async function saveFile() {
      try {
        const content = document.getElementById('file-textarea').value;
        await fetch('/api/file', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${jwtToken}` },
          body: JSON.stringify({ filePath: activeEditingFile, content })
        });
        alert('Saved successfully!');
      } catch (err) {
        alert('Failed to save file');
      }
    }

    function closeEditor() {
      document.getElementById('editor-pane').style.display = 'none';
      activeEditingFile = '';
    }

    // Admin Dashboard Logic
    async function loadAdminMetrics() {
      const card = document.getElementById('admin-metrics-card');
      card.innerHTML = 'Fetching telemetry...';
      try {
        const res = await fetch('/api/admin/metrics', {
          headers: { 'Authorization': `Bearer ${adminJwtToken}` }
        });
        if (!res.ok) throw new Error('Unauthorized');
        const data = await res.json();
        card.innerHTML = `
          <p><strong>Status:</strong> <span style="color: #2ecc71;">${data.status}</span></p>
          <p><strong>Uptime:</strong> ${data.serverUptimeSeconds}s</p>
          <p><strong>Memory RSS:</strong> ${data.memoryRSSMB} MB</p>
          <p><strong>Memory Heap:</strong> ${data.memoryHeapMB} MB</p>
          <p><strong>Runtime:</strong> Node ${data.nodeVersion} (${data.platform})</p>
        `;
      } catch (err) {
        card.innerHTML = `<span style="color: #e74c3c;">Access Denied: Admin role required.</span>`;
      }
    }

    async function triggerMaintenance() {
      if (!confirm('Run backend maintenance check?')) return;
      try {
        const res = await fetch('/api/admin/maintenance', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${adminJwtToken}` }
        });
        const data = await res.json();
        alert(data.message || 'Done.');
      } catch (err) {
        alert('Action failed.');
      }
    }
  </script>
</body>
</html>
